# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/eventhorizon

# --- JWT (login token) ---
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# --- Email verification ---
# Verification link = CLIENT_URL + /verify-email?token=...
# For testing without a frontend, use: http://localhost:5000/api/auth
CLIENT_URL=http://localhost:5000/api/auth
VERIFICATION_TOKEN_TTL_HOURS=24

# --- SMTP (leave EMAIL_HOST empty to just print the link in the console) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="EventHorizon <your_email@gmail.com>"
